# Copy this file to .env.local and fill in the values from
# Supabase dashboard → Project Settings → API Keys / Data API.
# .env.local stays on your Mac and is never committed.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# "Publishable key" (starts with sb_publishable_). Safe to use in the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# "Secret key" (starts with sb_secret_). Server only — never share it or put it in the browser.
SUPABASE_SECRET_KEY=

# Any long random string. Vercel Cron sends it to /api/cron/sync for the nightly inventory sync.
CRON_SECRET=
